  "required": [
    "format",
    "classification",
    "pilot",
    "binding",
    "checks",
    "evidence",
    "artifacts",
    "scope",
    "defects"
  ],
  "properties": {
    "format": {
      "enum": [
        "MVP050_CHECKLIST/v1"
      ]
    },
    "classification": {
      "enum": [
        "SYNTHETIC ONLY",
        "REAL UNVERIFIED"
      ]
    },
    "pilot": {
      "enum": [
        "FULL_MVP",
        "REDUCED_PILOT",
        "SYNTHETIC_DEMO"
      ]
    },
    "binding": {
      "type": "object",
      "required": [
        "release_id",
        "head",
        "base",
        "images",
        "schema",
        "modes",
        "content_sha256",
        "enabled_features"
      ],
      "properties": {
        "release_id": {
          "type": "string",
          "pattern": "rc-[0-9a-f]{32}"
        },
        "head": {
          "type": "string",
          "pattern": "[0-9a-f]{40}"
        },
        "base": {
          "type": "string",
          "pattern": "[0-9a-f]{40}"
        },
        "images": {
          "type": "object",
          "required": [
            "backend",
            "frontend",
            "postgres"
          ],
          "properties": {
            "backend": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "sha256:[0-9a-f]{64}"
                },
                {
                  "type": "null"
                }
              ]
            },
            "frontend": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "sha256:[0-9a-f]{64}"
                },
                {
                  "type": "null"
                }
              ]
            },
            "postgres": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "sha256:[0-9a-f]{64}"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "additionalProperties": false
        },
        "schema": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "[a-z0-9_]{1,64}"
            },
            {
              "type": "null"
            }
          ]
        },
        "modes": {
          "type": "object",
          "required": [
            "format",
            "data",
            "catalog",
            "orders",
            "chat",
            "knowledge",
            "files",
            "smtp",
            "clamav",
            "signature_update",
            "real_pii"
          ],
          "properties": {
            "format": {
              "enum": [
                1
              ]
            },
            "data": {
              "enum": [
                "synthetic-only"
              ]
            },
            "catalog": {
              "type": "boolean"
            },
            "orders": {
              "type": "boolean"
            },
            "chat": {
              "type": "boolean"
            },
            "knowledge": {
              "type": "boolean"
            },
            "files": {
              "type": "boolean"
            },
            "smtp": {
              "enum": [
                "disabled",
                "required"
              ]
            },
            "clamav": {
              "enum": [
                "disabled-files-blocked",
                "required"
              ]
            },
            "signature_update": {
              "enum": [
                "disabled-files-blocked",
                "required"
              ]
            },
            "real_pii": {
              "type": "boolean"
            }
